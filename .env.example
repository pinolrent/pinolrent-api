# Copia este archivo a `.env` y edita los valores. Sin `.env`, `make dev`
# usa defaults de desarrollo (ver scripts/dev.sh).

# Puerto del servidor API
PORT=8080

# Ruta del archivo SQLite (dev: dev.db, prod: pinolrent.db por default)
DATABASE_URL=dev.db

# Secreto HS256 para firmar tokens. En producción es obligatorio: el proceso aborta si falta o tiene menos de 32 bytes.
# Generar uno con: openssl rand -base64 32
JWT_SECRET=

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# "*" permite cualquiera (default; seguro solo porque no usamos cookies). En
# producción lista orígenes concretos, p. ej. https://app.example.com
CORS_ALLOWED_ORIGINS=*

# Entorno: dev (default) o prod/production. En prod, CORS_ALLOWED_ORIGINS=*
# es rechazado y el server no arranca hasta poner tu dominio.
ENV=dev

# Directorio donde se guardan las imágenes de POST /uploads (se crea solo).
UPLOAD_DIR=uploads

# Cap total del directorio de uploads, en MB (0 = sin límite). Al superarse,
# POST /uploads responde 507. Los huérfanos (sin referencia en la base) se
# limpian solos pasados 7 días.
UPLOAD_MAX_TOTAL_MB=1024

# Redes cuyo X-Forwarded-For/X-Real-IP se creen, separadas por coma (CIDR).
# Vacío = solo se confía en un proxy que corra en loopback (nginx/caddy en la
# misma máquina). Detrás de contenedores o un PaaS (Coolify, Fly, Railway) hay
# que listar la red del proxy, si no todos los clientes comparten el mismo
# contador de rate limit y los logs muestran la IP del proxy.
# Ejemplo: TRUSTED_PROXY_CIDRS=172.18.0.0/16
TRUSTED_PROXY_CIDRS=