# Copy this file to `.env` and edit the values. Without a `.env`, `make dev`
# uses the development defaults (see scripts/dev.sh).

# Port the API server listens on
PORT=8080

# Path to the SQLite file (dev: dev.db, prod: pinolrent.db by default)
DATABASE_URL=dev.db

# HS256 secret used to sign tokens. In production it is required: the process
# aborts if it is missing or shorter than 32 bytes.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Origins allowed to call the API from a browser, comma-separated.
# "*" allows anyone (the default; only safe because we do not use cookies). In
# production list concrete origins, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=*

# Environment: dev (default) or prod/production. In prod, CORS_ALLOWED_ORIGINS=*
# is rejected and the server refuses to start until you set your domain.
ENV=dev

# Directory where POST /uploads stores the images (created on demand).
UPLOAD_DIR=uploads

# Total size cap for the uploads directory, in MB (0 = no limit). Once
# exceeded, POST /uploads answers 507. Orphans (nothing in the database
# references them) are swept automatically after 7 days.
UPLOAD_MAX_TOTAL_MB=1024

# Networks whose X-Forwarded-For/X-Real-IP are believed, comma-separated (CIDR).
# Empty = only a proxy running on loopback is trusted (nginx/caddy on the same
# machine). Behind containers or a PaaS you must list the proxy network, or
# every client shares the same rate-limit counter and the logs show the proxy
# IP instead of the caller.
# Example: TRUSTED_PROXY_CIDRS=172.18.0.0/16
TRUSTED_PROXY_CIDRS=

# Allow-list of accounts with the admin role, comma-separated. It is the only
# source of the admin role: on startup the server grants the role to the
# listed accounts and revokes it from everyone else, so removing an email and
# restarting already takes the access away. There is no endpoint to grant it.
# Empty = the installation has no administrator (everything else is unchanged).
# A malformed entry makes the server refuse to start.
# Example: ADMIN_EMAILS=admin@pinolrent.cl
ADMIN_EMAILS=