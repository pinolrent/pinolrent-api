# Copia este archivo a `.env` y edita los valores. Sin `.env`, `make dev`
# usa defaults de desarrollo (ver scripts/dev.sh).

# Puerto del servidor API
PORT=8080

# Ruta del archivo SQLite (dev: dev.db, prod: pinolrent.db por default)
DATABASE_URL=dev.db

# Secreto HS256 para firmar tokens. En producción es obligatorio: el proceso aborta si falta o tiene menos de 32 bytes.
# Generar uno con: openssl rand -base64 32
JWT_SECRET=

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
# "*" permite cualquiera (default; seguro solo porque no usamos cookies). En
# producción lista orígenes concretos, p. ej. https://app.example.com
CORS_ALLOWED_ORIGINS=*

# Entorno: dev (default) o prod/production. En prod, CORS_ALLOWED_ORIGINS=*
# es rechazado y el server no arranca hasta poner tu dominio.
ENV=dev