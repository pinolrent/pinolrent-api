# Copia este archivo a `.env` y edita los valores. Sin `.env`, `make dev`
# usa defaults de desarrollo (ver scripts/dev.sh).

# Puerto del servidor API
PORT=8080

# Ruta del archivo SQLite de desarrollo
DATABASE_URL=dev.db

# Secreto HS256 para firmar tokens. En producción es obligatorio: el proceso aborta si falta.
JWT_SECRET=

# Email del admin que se siembra al arrancar
ADMIN_EMAIL=admin@pinolrent.com

# Password del admin. En producción es obligatorio: el proceso aborta si falta.
ADMIN_PASSWORD=