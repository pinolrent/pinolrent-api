meta {
  name: Crear auto
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/seller/cars
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "name": "Honda Fit",
    "price_per_day": 25000,
    "photo_url": "https://example.com/fit.jpg"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.id) {
    bru.setVar("carId", body.id);
  }
}