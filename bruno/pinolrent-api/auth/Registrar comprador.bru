meta {
  name: Registrar comprador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{buyerEmail}}",
    "password": "{{buyerPassword}}"
  }
}

assert {
  $res.status: eq 201
  $res.body.email: eq {{buyerEmail}}
}