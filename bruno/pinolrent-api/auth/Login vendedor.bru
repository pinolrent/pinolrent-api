meta {
  name: Login vendedor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{sellerEmail}}",
    "password": "{{sellerPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.token) {
    bru.setVar("sellerToken", body.token);
  }
}