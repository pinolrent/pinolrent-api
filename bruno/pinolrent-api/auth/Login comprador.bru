meta {
  name: Login comprador
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{buyerEmail}}",
    "password": "{{buyerPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.token) {
    bru.setVar("buyerToken", body.token);
  }
}