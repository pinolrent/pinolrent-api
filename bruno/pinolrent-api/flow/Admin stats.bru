meta {
  name: Admin stats
  type: http
  seq: 47
}

get {
  url: {{baseUrl}}/admin/stats
  body: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.users.total: isDefined
  res.body.reservations.pending: isDefined
  res.body.payments.approved_total: isDefined
}