meta {
  name: Seller login for correction
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{sellerEmail}}",
    "password": "{{sellerPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

script:post-response {
  const body = res.getBody();
  if (body.token) {
    bru.setVar("sellerToken", body.token);
  }
}
