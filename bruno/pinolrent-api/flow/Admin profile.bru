meta {
  name: Admin profile
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/auth/me
  body: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

assert {
  res.status: eq 200
}

script:post-response {
  const body = res.getBody();
  if (body.roles && body.roles.includes("admin")) {
    bru.setVar("adminUserId", body.id);
  }
}