meta {
  name: Create correction car
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/seller/cars
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "name": "Auto Corregible",
    "price_per_day": 30000
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  const body = res.getBody();
  if (body.id) {
    bru.setVar("correctionCarId", body.id);
  }
}
