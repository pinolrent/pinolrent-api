meta {
  name: Admin confirm reservation
  type: http
  seq: 46
}

patch {
  url: {{baseUrl}}/admin/reservations/{{reservationId}}/confirm
  body: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq confirmed
  res.body.payment.status: eq approved
}
