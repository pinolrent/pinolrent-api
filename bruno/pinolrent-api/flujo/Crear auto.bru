meta {
  name: Crear auto
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/seller/cars
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "name": "Honda Fit",
    "price_per_day": 25000,
    "photo_url": "{{uploadUrl}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  const body = res.getBody();
  if (body.id) {
    bru.setVar("carId", body.id);
  }
}
