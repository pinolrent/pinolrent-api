meta {
  name: Desactivar auto
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/seller/cars/{{carId}}
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{sellerToken}}
}

body:json {
  {
    "active": false
  }
}

assert {
  res.status: eq 200
  res.body.active: eq false
}
