meta {
  name: Registrar vendedor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register/seller
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{sellerEmail}}",
    "password": "{{sellerPassword}}",
    "phone": "{{sellerPhone}}"
  }
}

assert {
  res.status: eq 201
}
