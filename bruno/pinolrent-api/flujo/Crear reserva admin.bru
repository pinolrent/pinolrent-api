meta {
  name: Crear reserva admin
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/reservations
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{buyerToken}}
}

script:pre-request {
  const fmt = (offsetDays) => {
    const d = new Date();
    d.setDate(d.getDate() + offsetDays);
    return d.toISOString().slice(0, 10);
  };
  bru.setVar("adminStartDate", fmt(30));
  bru.setVar("adminEndDate", fmt(32));
}

body:json {
  {
    "car_id": {{carId}},
    "start_date": "{{adminStartDate}}",
    "end_date": "{{adminEndDate}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  const body = res.getBody();
  if (body.id) {
    bru.setVar("adminReservationId", body.id);
  }
}
