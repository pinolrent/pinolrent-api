meta {
  name: Confirmar reserva admin
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/seller/reservations/{{adminReservationId}}/confirm
  body: none
}

headers {
  Authorization: Bearer {{sellerToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq awaiting_admin
  res.body.payment.status: eq pending
}
