meta {
  name: Rechazar reserva
  type: http
  seq: 26
}

patch {
  url: {{baseUrl}}/seller/reservations/{{rejectionReservationId}}/reject
  body: none
}

headers {
  Authorization: Bearer {{sellerToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq cancelled
  res.body.payment.status: eq rejected
}
