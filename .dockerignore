# Build context: only what is needed to compile, and only what must not end up
# inside the image. In a remote build the context is the repo clone, but a
# local `docker build` uses the whole directory: without these ignores a stale
# dev.db or a .env with secrets would be baked into the image. `.git` is
# deliberately left out of the list: the build stage runs `git describe` to
# version the binary and the final image does not copy it.
.git
.github
.codegraph
bin/
tmp/
uploads/
*.db*
.env
docs/
bruno/
scripts/
README.md
AGENTS.md
